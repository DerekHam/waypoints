# Local development only. Never commit real secrets.
# Copy this file to worker/.dev.vars and fill in test values.
GITHUB_TOKEN = "github_pat_replace_me"
SESSION_SECRET = "replace-with-a-long-random-string"
# Generate with: npm run keygen -- "Your name"
# Use the generated array as the value (it is JSON).
EDITOR_KEYS = '[{"name":"Test editor","salt":"replace","hash":"replace"}]'
