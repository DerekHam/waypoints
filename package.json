{
  "name": "waypoints",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A bilingual antique-globe travel wishlist",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "keygen": "node scripts/make-key.mjs",
    "routes": "node scripts/precompute-routes.mjs",
    "map:style": "node scripts/build-map-style.mjs",
    "validate": "tsx scripts/validate-atlas.ts"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
